{
  "name": "gains-and-chains",
  "productName": "GAINS & CHAINS",
  "version": "0.1.0",
  "description": "Локальная офлайн слот-машина на виртуальной валюте",
  "author": "Andre",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/simulate.ts",
    "sim:quick": "tsx tools/simulate.ts --spins 200000",
    "app": "npm run build && electron .",
    "dist": "node tools/build-app.mjs",
    "dist:portable": "node tools/build-app.mjs --portable"
  },
  "build": {
    "appId": "com.gainschains.slot",
    "productName": "Gains and Chains",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "GainsAndChains-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gains and Chains",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GainsAndChains-portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
